-- Slider drag logic
local MIN_POWER = 50
local MAX_POWER = 500
local dragging = false

local function applyJumpPower(value)
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.JumpPower = value end
end

local function updateSlider(inputX)
    local trackPos   = sliderTrack.AbsolutePosition.X
    local trackWidth = sliderTrack.AbsoluteSize.X
    local rel = math.clamp((inputX - trackPos) / trackWidth, 0, 1)

    State.JumpPower = math.floor(MIN_POWER + rel * (MAX_POWER - MIN_POWER))
    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
    sliderKnob.Position = UDim2.new(rel, 0, 0.5, 0)
    sliderLabel.Text = "Jump Power: " .. State.JumpPower
    applyJumpPower(State.JumpPower)
end

sliderKnob.MouseButton1Down:Connect(function()
    dragging = true
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        updateSlider(input.Position.X)
    end
end)

-- ============================================================
-- KEYBIND: Q = toggle
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        toggleBtn.MouseButton1Click:Fire()
    end
end)

-- ============================================================
-- APPLY JUMP POWER ON RESPAWN
-- ============================================================
lp.CharacterAdded:Connect(function(newChar)
    char = newChar
    local hum = newChar:WaitForChild("Humanoid")
    hum.JumpPower = State.JumpPower
    if State.InfiniteJump then
        disableJump()
        enableJump()
    end
end)

print("[InfJump] Loaded — Q to toggle")
