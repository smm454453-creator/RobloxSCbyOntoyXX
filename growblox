toggleBtn.Parent = win

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 10)
toggleCorner.Parent = toggleBtn

local toggleStroke = Instance.new("UIStroke")
toggleStroke.Color = Color3.fromRGB(60, 60, 90)
toggleStroke.Thickness = 1.2
toggleStroke.Parent = toggleBtn

local function setToggleVisual(enabled)
    local targetBg    = enabled and Color3.fromRGB(40, 160, 90)   or Color3.fromRGB(40, 40, 60)
    local targetText  = enabled and Color3.fromRGB(200, 255, 220) or Color3.fromRGB(180, 180, 180)
    local targetStroke = enabled and Color3.fromRGB(60, 220, 110) or Color3.fromRGB(60, 60, 90)

    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = targetBg,
        TextColor3       = targetText,
    }):Play()
    TweenService:Create(toggleStroke, TweenInfo.new(0.2), {
        Color = targetStroke,
    }):Play()

    toggleBtn.Text = "Infinite Jump: " .. (enabled and "ON" or "OFF")
end

toggleBtn.MouseButton1Click:Connect(function()
    State.InfiniteJump = not State.InfiniteJump
    setToggleVisual(State.InfiniteJump)
    if State.InfiniteJump then
        enableJump()
    else
        disableJump()
    end
end)

